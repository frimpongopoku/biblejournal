# ─────────────────────────────────────────────────────────────────────────────
# BibJournal — Environment Variables
# Copy this file to .env.local for local development.
# On Vercel: add each variable in Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase (required) ───────────────────────────────────────────────────────
# Get these from Firebase Console → Project Settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── App URL (required for OG images on public proclamation pages) ─────────────
# Set to your production URL, e.g. https://bibjournal.vercel.app
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ── Anthropic (required for Research AI features) ────────────────────────────
# Get from https://console.anthropic.com — used for Commentary, Ask, Word Study
ANTHROPIC_API_KEY=

# ── Voyage AI (required for semantic Bible search in Research → Ask) ─────────
# Get from https://dashboard.voyageai.com — free tier: 200M tokens
# After getting key, run: npm run embed   (one-time, generates data/ files)
VOYAGEAI_API_KEY=
